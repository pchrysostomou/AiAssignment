#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspace/node_modules/.pnpm/JSONStream@0.8.4_dc72a09be7da312d1c4f969f2aaee6da/node_modules/JSONStream/node_modules:/workspace/node_modules/.pnpm/JSONStream@0.8.4_dc72a09be7da312d1c4f969f2aaee6da/node_modules:/workspace/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspace/node_modules/.pnpm/JSONStream@0.8.4_dc72a09be7da312d1c4f969f2aaee6da/node_modules/JSONStream/node_modules:/workspace/node_modules/.pnpm/JSONStream@0.8.4_dc72a09be7da312d1c4f969f2aaee6da/node_modules:/workspace/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../JSONStream/index.js" "$@"
else
  exec node  "$basedir/../JSONStream/index.js" "$@"
fi
